    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "idb": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
