# ── Anthropic ──────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── HuggingFace (Distil-Whisper transcription + nomic embeddings) ──────────────
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your-key-here

# ── Pinecone (semantic vector search) ─────────────────────────────────────────
# Get your key at: https://app.pinecone.io/
# Run `node scripts/seed-pinecone.js` once after setting these
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=hvac-knowledge

# ── AWS S3 (Primary Job Storage) ───────────────────────────────────────────────
# Create AWS account at: https://aws.amazon.com/
# Generate credentials: IAM → Users → Create user with S3 full access
# Bucket name can be any unique name (e.g., hvac-pro-jobs-yourname)
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=AKIA...
VITE_AWS_SECRET_ACCESS_KEY=wJalrXUt...
VITE_AWS_S3_BUCKET=hvac-pro-jobs

# ── Supabase (OPTIONAL - Legacy/Backup) ────────────────────────────────────────
# Now OPTIONAL if using S3 exclusively
# Create a free project at: https://supabase.com/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Parts Lookup ───────────────────────────────────────────────────────────────
# Set to "demo" to use built-in mock data (default)
VITE_PARTS_PROVIDER=demo
VITE_GRAINGER_API_KEY=your-grainger-key
VITE_GRAINGER_ACCOUNT=your-grainger-account
